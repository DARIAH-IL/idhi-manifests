    skos:definition "Wikidata contributors, \"Q98848097,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q98848097&oldid=1270670374 (accessed September 4, 2020)." .

tadirah:tagging a owl:Class ;
    rdfs:label "tadirah:tagging" ;
    dcterms:title "Tagging" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "the act of labelling a piece of data or content wth a short string to express some metadata (Wikidata contributors, \"Q43401994,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q43401994&oldid=1198888121 (accessed September 4, 2020)" .

tadirah:teaching a owl:Class ;
    rdfs:label "tadirah:teaching" ;
    dcterms:title "Teaching" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum .

tadirah:textCategorization a owl:Class ;
    rdfs:label "tadirah:textCategorization" ;
    dcterms:title "Text Categorization" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "Wikidata contributors, \"Q57771142,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q57771142&oldid=1072020823 (accessed September 4, 2020)." .

tadirah:textMessaging a owl:Class ;
    rdfs:label "tadirah:textMessaging" ;
    dcterms:title "Text Messaging" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "act of typing and sending a brief, digital message (Wikidata contributors, \"Q17166101,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q17166101&oldid=1266645836 (accessed September 4, 2020)." .

tadirah:theorizing a owl:Class ;
    rdfs:label "tadirah:theorizing" ;
    dcterms:title "Theorizing" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum .

tadirah:topicModeling a owl:Class ;
    rdfs:label "tadirah:topicModeling" ;
    dcterms:title "Topic Modeling" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "set of techniques in computational linguistics and related fields (Wikidata contributors, \"Q96468792,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q96468792&oldid=1211601100 (accessed July 30, 2020)." .

tadirah:transcoding a owl:Class ;
    rdfs:label "tadirah:transcoding" ;
    dcterms:title "Transcoding" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "direct digital-to-digital conversion of one encoding to another (Wikidata contributors, \"Q1888734,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q1888734&oldid=1225865439 (accessed September 4, 2020)." .

tadirah:transcribing a owl:Class ;
    rdfs:label "tadirah:transcribing" ;
    dcterms:title "Transcribing" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "transcribing describes  the activity of creating a representation of a manuscript or of audio or video recordings. The representation is generally textual for the verbal aspects of recordings and structured for example by speech turns. It can also contain multimodal information like gestures or events and multimedia information like time synchronization and relation to media files." .

tadirah:transformation a owl:Class ;
    rdfs:label "tadirah:transformation" ;
    dcterms:title "Transformation" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "process involving change into a qualitatively different form (Wikidata contributors, \"Q65757353,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q65757353&oldid=1268189392 (accessed September 4, 2020)." .

tadirah:translating a owl:Class ;
    rdfs:label "tadirah:translating" ;
    dcterms:title "Translating" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum .

tadirah:treeTagging a owl:Class ;
    rdfs:label "tadirah:treeTagging" ;
    dcterms:title "Tree-Tagging" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "Wikidata contributors, \"Q98845582,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q98845582&oldid=1270642307 (accessed September 4, 2020)." .

tadirah:tweet a owl:Class ;
    rdfs:label "tadirah:tweet" ;
    dcterms:title "Tweet" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "individual post on the Twitter microblogging service (Wikidata contributors, \"Q56119332,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q56119332&oldid=1249804975 (accessed September 4, 2020)." .

tadirah:uniformResourceIdentifier a owl:Class ;
    rdfs:label "tadirah:uniformResourceIdentifier" ;
    dcterms:title "Uniform Resource Identifier" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "string of characters used to identify a name of a resource on a network such as the internet (Wikidata contributors, \"Q61694,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q61694&oldid=1253478595 (accessed September 4, 2020)." .

tadirah:upload a owl:Class ;
    rdfs:label "tadirah:upload" ;
    dcterms:title "Upload" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "sending of data from a local system to a remote system (Wikidata contributors, \"Q7126699,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q7126699&oldid=1267188395 (accessed September 4, 2020)." .

tadirah:userGeneratedContent a owl:Class ;
    rdfs:label "tadirah:userGeneratedContent" ;
    dcterms:title "User Generated Content" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "online content created by users (Wikidata contributors, \"Q579716,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q579716&oldid=1244820573 (accessed September 4, 2020)." .

tadirah:versioning a owl:Class ;
    rdfs:label "tadirah:versioning" ;
    dcterms:title "Versioning" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum .

tadirah:videoCapture a owl:Class ;
    rdfs:label "tadirah:videoCapture" ;
    dcterms:title "Video Capture" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "Wikidata contributors, \"Q2778015,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q2778015&oldid=1112440881 (accessed September 4, 2020)." .

tadirah:videoConference a owl:Class ;
    rdfs:label "tadirah:videoConference" ;
    dcterms:title "Video Conference" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "type of conference (Wikidata contributors, \"Q238354,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q238354&oldid=1262194128 (accessed September 4, 2020)." .

tadirah:videoEditing a owl:Class ;
    rdfs:label "tadirah:videoEditing" ;
    dcterms:title "Video Editing" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "editing live television and video production (Wikidata contributors, \"Q1154312,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q1154312&oldid=1149134104 (accessed September 4, 2020)." .

tadirah:visualAnalysis a owl:Class ;
    rdfs:label "tadirah:visualAnalysis" ;
    dcterms:title "Visual Analysis" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum .

tadirah:visualAnnotation a owl:Class ;
    rdfs:label "tadirah:visualAnnotation" ;
    dcterms:title "Visual Annotation" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "Wikidata contributors, \"Q98847784,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q98847784&oldid=1270668347 (accessed September 4, 2020)." .

tadirah:webCrawling a owl:Class ;
    rdfs:label "tadirah:webCrawling" ;
    dcterms:title "Web Crawling" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "systematic access of resources across the web (Wikidata contributors, \"Q61466324,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q61466324&oldid=1232626072 (accessed July 30, 2020)." .

tadirah:webDevelopment a owl:Class ;
    rdfs:label "tadirah:webDevelopment" ;
    dcterms:title "Web Development" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum .

tadirah:webScraping a owl:Class ;
    rdfs:label "tadirah:webScraping" ;
    dcterms:title "Web Scraping" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "data scraping used for extracting data from websites (Wikidata contributors, \"Q665452,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q665452&oldid=1203621822 (accessed September 4, 2020)." .

tadirah:wireframing a owl:Class ;
    rdfs:label "tadirah:wireframing" ;
    dcterms:title "Wireframing" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "Wikidata contributors, \"Q98845203,\" Wikidata, https://www.wikidata.org/w/index.php?title=Q98845203&oldid=1270637566 (accessed September 4, 2020)." .

tadirah:writing a owl:Class ;
    rdfs:label "tadirah:writing" ;
    dcterms:title "Writing" ;
    rdfs:subClassOf idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "writing designates the activity of creating new texts (instead of capturing existing text). Here, it primarily concerns research papers and reports, but may include other textually-oriented objects." .

idhi:Affiliation a owl:Class ;
    rdfs:label "Affiliation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom idhi:PersonOrgRoleEnum ;
            owl:onProperty idhi:affiliation_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:affiliation_role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:organization ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:organization ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Organization ;
            owl:onProperty idhi:organization ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:affiliation_role ],
        idhi:Relationship ;
    skos:definition "A person's employment or membership at an organization, nested in a Person so the member is inferred from the containing record. Use in Person.affiliations for the person's institutional home(s), independent of any project; do not provide the containing person's ID in the relationship." ;
    skos:exactMatch cerif:Person_OrganisationUnit ;
    skos:inScheme idhi:idhi .

idhi:Authorship a owl:Class ;
    rdfs:label "Authorship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:authorship_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty idhi:author_order ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:author ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Person ;
            owl:onProperty idhi:author ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:AuthorshipRoleEnum ;
            owl:onProperty idhi:authorship_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:author_order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:author ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:author_order ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:authorship_role ],
        idhi:Relationship ;
    skos:definition "A person's contribution nested in a Publication, so the publication is inferred from the containing record. Use one instance per author in Publication.authorships and do not define authorship in Person; author_order preserves the byline sequence with 1 as the first author." ;
    skos:exactMatch schema1:Role ;
    skos:inScheme idhi:idhi .

idhi:EventAgentRole a owl:Class ;
    rdfs:label "EventAgentRole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:event_agent_role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:event_agent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:event_agent_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:EventAgentRoleEnum ;
            owl:onProperty idhi:event_agent_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:event_agent ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Agent ;
            owl:onProperty idhi:event_agent ],
        idhi:Relationship ;
    skos:definition "A person or organization involved in the containing Event in a defined capacity, with optional dates when the involvement covers only part of a multi-day event or programme. Use in Event.event_agent_roles for organizers, hosts, speakers, panelists, participants or sponsors; do not use it merely because an agent authored a publication presented at the event." ;
    skos:exactMatch schema1:Role ;
    skos:inScheme idhi:idhi .

idhi:FacilityAffiliation a owl:Class ;
    rdfs:label "FacilityAffiliation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:organization ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:facility_affiliation_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:FacilityAffiliationRoleEnum ;
            owl:onProperty idhi:facility_affiliation_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:organization ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:facility_affiliation_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Organization ;
            owl:onProperty idhi:organization ],
        idhi:Relationship ;
    skos:definition "A facility's affiliation with an organization, nested in a Facility so the facility is inferred from the containing record. Use one instance per hosting or owning organization in Facility.facility_affiliations and do not provide the containing facility's ID; joint labs get several." ;
    skos:exactMatch cerif:Facility_OrganisationUnit ;
    skos:inScheme idhi:idhi .

idhi:OrganizationHierarchy a owl:Class ;
    rdfs:label "OrganizationHierarchy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:parent_organization ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:parent_organization ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Organization ;
            owl:onProperty idhi:parent_organization ],
        idhi:Relationship ;
    skos:definition "Formal containment of the containing Organization within a larger parent organization, with optional validity dates. Use in Organization.organization_hierarchy for departments, laboratories, centers or subsidiaries that are structurally part of another organization; do not use it for partnerships, project participation or informal association." ;
    skos:exactMatch schema1:Role ;
    skos:inScheme idhi:idhi .

idhi:OrganizationProjectRole a owl:Class ;
    rdfs:label "OrganizationProjectRole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom idhi:OrgProjectRoleEnum ;
            owl:onProperty idhi:org_project_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Organization ;
            owl:onProperty idhi:organization ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:org_project_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:org_project_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:organization ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:organization ],
        idhi:Relationship ;
    skos:definition "An organization's engagement nested in a Project, so the project is inferred from the containing record. Use one instance per role in Project.organization_roles and do not provide the containing project's ID. Represent a known distinct funding award with Funding rather than an additional FUNDER role; use FUNDER only when no award can be described." ;
    skos:exactMatch cerif:Project_OrganisationUnit ;
    skos:inScheme idhi:idhi .

idhi:ProjectParticipation a owl:Class ;
    rdfs:label "ProjectParticipation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:participation_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:participant ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:participation_role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:participant ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:ProjectRoleEnum ;
            owl:onProperty idhi:participation_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Person ;
            owl:onProperty idhi:participant ],
        idhi:Relationship ;
    skos:definition "A person's participation nested in a Project, so the project is inferred from the containing record. Use one instance per participant and role in Project.project_participations and do not define project participation in Person; if a person changed roles over time, create one instance per role with start and end dates." ;
    skos:exactMatch cerif:Project_Person ;
    skos:inScheme idhi:idhi .

idhi:affiliation_role a owl:ObjectProperty ;
    rdfs:label "affiliation_role" ;
    rdfs:range idhi:PersonOrgRoleEnum ;
    skos:definition "The person's position at the organization (their job/status, not their project role). Use EMPLOYEE when no finer value fits; AFFILIATE is for formal association without employment." ;
    skos:inScheme idhi:idhi .

idhi:author a owl:ObjectProperty ;
    rdfs:label "author" ;
    rdfs:range idhi:Person ;
    skos:definition "The person contributing to the containing publication (by IDHI URN). Use in Publication.authorships; do not define the relationship on the Person." ;
    skos:inScheme idhi:idhi .

idhi:author_order a owl:DatatypeProperty ;
    rdfs:label "author_order" ;
    rdfs:range xsd:integer ;
    skos:definition "Position in the byline; 1 = first author." ;
    skos:inScheme idhi:idhi .

idhi:authorship_role a owl:ObjectProperty ;
    rdfs:label "authorship_role" ;
    rdfs:range idhi:AuthorshipRoleEnum ;
    skos:definition "The kind of contribution. AUTHOR is the default for byline authors; use EDITOR/TRANSLATOR for edited volumes and translations; CONTRIBUTOR for named non-byline contributions." ;
    skos:inScheme idhi:idhi .

idhi:byte_size a owl:DatatypeProperty ;
    rdfs:label "byte_size" ;
    rdfs:range xsd:integer ;
    skos:definition "Total size of the described dataset distribution in bytes. Use an exact or documented aggregate byte count and omit it when only an unreliable estimate is available." ;
    skos:inScheme idhi:idhi .

idhi:code_repository a owl:DatatypeProperty ;
    rdfs:label "code_repository" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Source-code repository URL (GitHub, GitLab...), if open." ;
    skos:inScheme idhi:idhi .

idhi:contributor a owl:ObjectProperty ;
    rdfs:label "contributor" ;
    rdfs:range idhi:Agent ;
    skos:definition "The person or organization contributing to the containing Tool or Dataset (by IDHI URN). Use only in resource_contributions; do not duplicate the relationship on the Agent." ;
    skos:inScheme idhi:idhi .

idhi:dataset_type a owl:ObjectProperty ;
    rdfs:label "dataset_type" ;
    rdfs:range idhi:DatasetTypeEnum ;
    skos:definition "The dataset's primary intellectual or collection form. Use this for discovery categories such as digital edition, corpus or gazetteer; use media_type for its technical serialization." ;
    skos:inScheme idhi:idhi .

idhi:distribution_url a owl:DatatypeProperty ;
    rdfs:label "distribution_url" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Direct download or access URL for the dataset." ;
    skos:inScheme idhi:idhi .

idhi:event_agent a owl:ObjectProperty ;
    rdfs:label "event_agent" ;
    rdfs:range idhi:Agent ;
    skos:definition "The person or organization involved in the containing event (by IDHI URN). Use only in Event.event_agent_roles; do not duplicate the relationship on the Agent." ;
    skos:inScheme idhi:idhi .

idhi:event_agent_role a owl:ObjectProperty ;
    rdfs:label "event_agent_role" ;
    rdfs:range idhi:EventAgentRoleEnum ;
    skos:definition "The capacity in which the agent is involved in the containing event. Choose the most specific applicable role and create separate relationships when the same agent has multiple roles." ;
    skos:inScheme idhi:idhi .

idhi:event_type a owl:ObjectProperty ;
    rdfs:label "event_type" ;
    rdfs:range idhi:EventTypeEnum ;
    skos:definition "The kind of scholarly event." ;
    skos:inScheme idhi:idhi .

idhi:facility_affiliation_role a owl:ObjectProperty ;
    rdfs:label "facility_affiliation_role" ;
    rdfs:range idhi:FacilityAffiliationRoleEnum ;
    skos:definition "The organization's relationship to the containing facility. Use HOST when it provides the facility's institutional or operational home and OWNER when it legally or administratively owns the facility; create two relationships when distinct organizations fill those roles." ;
    skos:inScheme idhi:idhi .

idhi:funding_amount a owl:DatatypeProperty ;
    rdfs:label "funding_amount" ;
    rdfs:range xsd:float ;
    skos:definition "Amount awarded by the funding organization, if public, in ILS unless noted in the project description. Omit rather than guess." ;
    skos:inScheme idhi:idhi .

idhi:funding_organization a owl:ObjectProperty ;
    rdfs:label "funding_organization" ;
    rdfs:range idhi:Organization ;
    skos:definition "The organization that provides this funding award (by IDHI URN)." ;
    skos:inScheme idhi:idhi .

idhi:funding_status a owl:ObjectProperty ;
    rdfs:label "funding_status" ;
    rdfs:range idhi:FundingStatusEnum ;
    skos:definition "The project's current primary funding or sustainability status at the time the record is maintained. Use this for present support, while funding records preserve past and current award history; update it when the project's circumstances change. This uses an IDHI-specific property because established vocabularies do not provide a controlled current-sustainability status for projects." ;
    skos:inScheme idhi:idhi .

idhi:funding_url a owl:DatatypeProperty ;
    rdfs:label "funding_url" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Public landing page for the individual award or its authoritative funding record. Use the funding organization's homepage on the Organization record instead when no award-specific page exists." ;
    skos:inScheme idhi:idhi .

idhi:grant_number a owl:DatatypeProperty ;
    rdfs:label "grant_number" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier assigned to the grant by its funding organization. Use the funder's exact value and omit it when none is published." ;
    skos:inScheme idhi:idhi .

idhi:homepage a owl:DatatypeProperty ;
    rdfs:label "homepage" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Public landing page of the entity, if one exists." ;
    skos:inScheme idhi:idhi .

idhi:image a owl:DatatypeProperty ;
    rdfs:label "image" ;
    rdfs:range xsd:base64Binary ;
    skos:definition "A representative image embedded as Base64-encoded binary content. Use for a single image that must travel with the entity record; omit it when no image is available, and use homepage or additional_urls for externally hosted pages rather than encoding a URL here." ;
    skos:inScheme idhi:idhi .

idhi:language a owl:DatatypeProperty ;
    rdfs:label "language" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*$" ] ) ] ) ] ;
    skos:definition "BCP-47 language tag of the value, such as en, he, ar, de, yi or lad. Use the shortest registered tag that accurately identifies the text; the deliberately permissive syntax guard accepts private and grandfathered tags and does not verify registration in the IANA language-subtag registry." ;
    skos:inScheme idhi:idhi .

idhi:marketplace_sync a owl:DatatypeProperty ;
    rdfs:label "marketplace_sync" ;
    rdfs:range xsd:boolean ;
    skos:definition "Opt-in flag for synchronization with the DARIAH SSH Open Marketplace. Set true to allow the organization and entities related to it through IDHI references, such as services and tools, to be synchronized; false or omission means they must not be synchronized on this organization's authority. This operational flag does not assert ownership of related entities. It uses an IDHI-specific property because established descriptive vocabularies do not provide a term for this synchronization policy." ;
    skos:inScheme idhi:idhi .

idhi:material_url a owl:DatatypeProperty ;
    rdfs:label "material_url" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Direct landing or access URL for the instructional resource. Use homepage for a broader site about the material and material_url for the resource learners open." ;
    skos:inScheme idhi:idhi .

idhi:orcid a owl:DatatypeProperty ;
    rdfs:label "orcid" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The person's persistent researcher identifier. It supplements the IDHI record id. Strongly recommended for every researcher; enables deduplication and linking to the scholarly record." ;
    skos:inScheme idhi:idhi .

idhi:org_project_role a owl:ObjectProperty ;
    rdfs:label "org_project_role" ;
    rdfs:range idhi:OrgProjectRoleEnum ;
    skos:definition "The organization's function in the project: COORDINATOR leads the consortium, PARTNER contributes work, DATA_PROVIDER supplies source data, FUNDER records funding when no distinct award can be described, and HOST provides the institutional home. Create one relationship instance per role, and do not duplicate an award already represented in funding." ;
    skos:inScheme idhi:idhi .

idhi:organization_type a owl:ObjectProperty ;
    rdfs:label "organization_type" ;
    rdfs:range idhi:OrganizationTypeEnum ;
    skos:definition "The kind of organization. Always set it." ;
    skos:inScheme idhi:idhi .

idhi:parent_organization a owl:ObjectProperty ;
    rdfs:label "parent_organization" ;
    rdfs:range idhi:Organization ;
    skos:definition "The larger organization containing the current child organization (by IDHI URN). Use only in Organization.organization_hierarchy; define the relationship on the child rather than the parent." ;
    skos:inScheme idhi:idhi .

idhi:part_of a owl:DatatypeProperty ;
    rdfs:label "part_of" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The containing work (book for a chapter, proceedings for a paper), by IDHI URN or external URI." ;
    skos:inScheme idhi:idhi .

idhi:part_of_training_material a owl:ObjectProperty ;
    rdfs:label "part_of_training_material" ;
    rdfs:range idhi:TrainingMaterial ;
    skos:definition "The larger training material of which this resource is a module or lesson (by IDHI URN). Use only for formal instructional containment, not loose topical similarity." ;
    skos:inScheme idhi:idhi .

idhi:participant a owl:ObjectProperty ;
    rdfs:label "participant" ;
    rdfs:range idhi:Person ;
    skos:definition "The person taking part in the containing project (by IDHI URN). Use in Project.project_participations; do not define the relationship on the Person." ;
    skos:inScheme idhi:idhi .

idhi:participation_role a owl:ObjectProperty ;
    rdfs:label "participation_role" ;
    rdfs:range idhi:ProjectRoleEnum ;
    skos:definition "The person's function within the project team. Use PRINCIPAL_INVESTIGATOR only for the formally designated PI(s); DH_LEAD for digital method and architecture, TECHNICAL_LEAD for ownership of software engineering, DEVELOPER for implementation, CONSULTANT for bounded external professional work, RESEARCHER for scholarly research, STUDENT for enrolled students, ADVISOR for mentorship, and CONTRIBUTOR only when none of the specific values fits." ;
    skos:inScheme idhi:idhi .

idhi:programming_language a owl:DatatypeProperty ;
    rdfs:label "programming_language" ;
    rdfs:range xsd:string ;
    skos:definition "Main implementation language, as a single technical label such as Python. Do not use this slot for natural languages supported by the tool." ;
    skos:inScheme idhi:idhi .

idhi:provider a owl:ObjectProperty ;
    rdfs:label "provider" ;
    rdfs:range idhi:Organization ;
    skos:definition "The organization formally responsible for delivering the service (the one you'd contact or contract with) — set this even when the service is listed under a Facility." ;
    skos:inScheme idhi:idhi .

idhi:publication_type a owl:ObjectProperty ;
    rdfs:label "publication_type" ;
    rdfs:range idhi:PublicationTypeEnum ;
    skos:definition "The kind of publication (journal article, book part, conference paper, thesis...). Pick the most specific applicable value." ;
    skos:inScheme idhi:idhi .

idhi:resource_contribution_role a owl:ObjectProperty ;
    rdfs:label "resource_contribution_role" ;
    rdfs:range idhi:ResourceContributionRoleEnum ;
    skos:definition "The contributor's responsibility for the containing Tool or Dataset. Choose the most specific applicable role and create separate relationships when one contributor has materially distinct responsibilities." ;
    skos:inScheme idhi:idhi .

idhi:ror a owl:DatatypeProperty ;
    rdfs:label "ror" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The organization's persistent registry identifier. It supplements the IDHI record id. Record it whenever the organization is registered in ROR — most universities and research institutes are." ;
    skos:inScheme idhi:idhi .

idhi:service_type a owl:ObjectProperty ;
    rdfs:label "service_type" ;
    rdfs:range idhi:ToolServiceTypeEnum ;
    skos:definition "The kind of service offered (digitization, consulting...)." ;
    skos:inScheme idhi:idhi .

idhi:tool_type a owl:ObjectProperty ;
    rdfs:label "tool_type" ;
    rdfs:range idhi:ToolServiceTypeEnum ;
    skos:definition "The delivery form of the tool (web app, library, CLI...). Pick the single value describing how users primarily consume it." ;
    skos:inScheme idhi:idhi .

idhi:training_material_type a owl:ObjectProperty ;
    rdfs:label "training_material_type" ;
    rdfs:range idhi:TrainingMaterialTypeEnum ;
    skos:definition "The material's primary didactic form. Choose the single value that best describes how learners engage with it, not its file format." ;
    skos:inScheme idhi:idhi .

idhi:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range xsd:string ;
    skos:definition "A localized text, in the language given by 'language'." ;
    skos:inScheme idhi:idhi .

idhi:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:address ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:event_agent_roles ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:EventTypeEnum ;
            owl:onProperty idhi:event_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:event_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:additional_urls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:end_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty idhi:end_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:end_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "idhi:Event" ] ) ] ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:start_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:location ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty idhi:start_date ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:location ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:EventAgentRole ;
            owl:onProperty idhi:event_agent_roles ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:address ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:event_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:additional_urls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:start_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:name ],
        idhi:Entity ;
    skos:definition "A scholarly event: conference, workshop, seminar, lecture, hackathon or exhibition. Use Event for time-bounded gatherings; recurring series should be modeled as one Event per occurrence." ;
    skos:exactMatch schema1:Event ;
    skos:inScheme idhi:idhi .

idhi:FacilityAffiliationRoleEnum a owl:Class ;
    rdfs:label "FacilityAffiliationRoleEnum" ;
    owl:unionOf ( <https://idhi_placeholder/linkml/FacilityAffiliationRoleEnum#HOST> schema1:owns ) ;
    skos:definition "IDHI-governed roles distinguishing the organizations connected to a facility. Use one relationship per organization and role so hosting and ownership are not conflated." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values schema1:owns,
        <https://idhi_placeholder/linkml/FacilityAffiliationRoleEnum#HOST> .

idhi:ResourceContribution a owl:Class ;
    rdfs:label "ResourceContribution" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:resource_contribution_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:contributor ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:contributor ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:ResourceContributionRoleEnum ;
            owl:onProperty idhi:resource_contribution_role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:resource_contribution_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Agent ;
            owl:onProperty idhi:contributor ],
        idhi:Relationship ;
    skos:definition "A person or organization contributing to the containing Tool or Dataset in a defined capacity, with optional dates for time-bounded responsibility. Use in Tool.resource_contributions or Dataset.resource_contributions for creation, software development, maintenance, data curation or other named contributions; use publisher where supported for formal publication responsibility and Project.project_participations for project-level work." ;
    skos:exactMatch schema1:Role ;
    skos:inScheme idhi:idhi .

idhi:datasets a owl:ObjectProperty ;
    rdfs:label "datasets" ;
    rdfs:range idhi:Dataset ;
    skos:definition "All Dataset records in the index, including digital archives and catalogs.",
        "Datasets aggregated by a Dataset that functions as a catalog (by id)." ;
    skos:inScheme idhi:idhi .

idhi:in_languages a owl:DatatypeProperty ;
    rdfs:label "in_languages" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*$" ] ) ] ) ] ;
    skos:definition "Languages substantially represented in a dataset or in which instructional content is available, using BCP-47 tags. For training material, record every complete language version and do not include a language used only in captions or examples; for datasets, record the languages of the data rather than its metadata page." ;
    skos:inScheme idhi:idhi .

idhi:resource_contributions a owl:ObjectProperty ;
    rdfs:label "resource_contributions" ;
    rdfs:range idhi:ResourceContribution ;
    skos:definition "Named contributions to the containing Tool or Dataset, with contributor, role and optional dates. Define each contribution only on the resource; use publisher where supported for the organization formally releasing it and Project.project_participations for work described only at project level." ;
    skos:inScheme idhi:idhi .

<https://credit.niso.org/contributor-roles/software/> a owl:Class ;
    rdfs:label "DEVELOPER",
        "TECHNICAL_LEAD" ;
    rdfs:subClassOf idhi:ProjectRoleEnum,
        idhi:ResourceContributionRoleEnum ;
    skos:definition "A team member implementing the project's software under their own or another person's technical direction; use TECHNICAL_LEAD when they own the engineering architecture and maintenance.",
        "Designs or implements software in a Tool; do not use for dataset curation or for project-level participation without a specific resource contribution.",
        "Owns or directs the project's software engineering and technical maintenance. Use this when responsibility exceeds implementation by a DEVELOPER; use DH_LEAD instead for leadership of the scholarly digital method or data model." .

idhi:media_type a owl:DatatypeProperty ;
    rdfs:label "media_type" ;
    rdfs:range xsd:string ;
    skos:definition "Technical media type of the primary dataset distribution or training resource, preferably an IANA media type such as text/html, application/pdf, application/vnd.apache.parquet or video/mp4. Dataset records may list multiple formats; do not use this for an intellectual or didactic form, which belongs in dataset_type or training_material_type." ;
    skos:inScheme idhi:idhi .

idhi:AuthorshipRoleEnum a owl:Class ;
    rdfs:label "AuthorshipRoleEnum" ;
    owl:unionOf ( <https://idhi_placeholder/linkml/AuthorshipRoleEnum#AUTHOR> <https://idhi_placeholder/linkml/AuthorshipRoleEnum#EDITOR> <https://idhi_placeholder/linkml/AuthorshipRoleEnum#TRANSLATOR> <https://idhi_placeholder/linkml/AuthorshipRoleEnum#CONTRIBUTOR> ) ;
    skos:definition "The kind of contribution to a publication." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values <https://idhi_placeholder/linkml/AuthorshipRoleEnum#AUTHOR>,
        <https://idhi_placeholder/linkml/AuthorshipRoleEnum#CONTRIBUTOR>,
        <https://idhi_placeholder/linkml/AuthorshipRoleEnum#EDITOR>,
        <https://idhi_placeholder/linkml/AuthorshipRoleEnum#TRANSLATOR> .

idhi:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:orcid ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:family_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:orcid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:orcid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:given_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:emails ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:emails ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:given_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "idhi:Person" ] ) ] ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:family_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:affiliations ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Affiliation ;
            owl:onProperty idhi:affiliations ],
        idhi:Agent ;
    skos:definition "A human agent in the DH index: researcher, developer, librarian, student, etc." ;
    skos:exactMatch foaf:Person ;
    skos:inScheme idhi:idhi .

idhi:Publication a owl:Class ;
    rdfs:label "Publication" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:presented_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty idhi:date_issued ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Authorship ;
            owl:onProperty idhi:authorships ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:doi ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "idhi:Publication" ] ) ] ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:publication_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:part_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Event ;
            owl:onProperty idhi:presented_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:published_in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:PublicationTypeEnum ;
            owl:onProperty idhi:publication_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:part_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Organization ;
            owl:onProperty idhi:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:published_in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:date_issued ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:date_issued ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:publication_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:doi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:doi ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:authorships ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:part_of ],
        idhi:Entity ;
    skos:definition "An academic publication: journal article, book, chapter, conference paper, thesis, report, etc. The precise kind is given by publication_type." ;
    skos:exactMatch bibo:Document ;
    skos:inScheme idhi:idhi .

idhi:TrainingMaterial a owl:Class ;
    rdfs:label "TrainingMaterial" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:doi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:in_languages ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:media_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:target_audiences ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:TrainingMaterialTypeEnum ;
            owl:onProperty idhi:training_material_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:related_datasets ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:training_material_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:part_of_training_material ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Tool ;
            owl:onProperty idhi:related_tools ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:license ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:license ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Organization ;
            owl:onProperty idhi:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:learning_outcomes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:creators ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "idhi:TrainingMaterial" ] ) ] ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:additional_urls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:educational_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:TrainingMaterial ;
            owl:onProperty idhi:part_of_training_material ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty idhi:date_issued ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:material_url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:digital_humanities_activities ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*$" ] ) ] ) ] ;
            owl:onProperty idhi:in_languages ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Service ;
            owl:onProperty idhi:related_services ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:date_issued ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:material_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:related_services ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:material_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:prerequisites ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Agent ;
            owl:onProperty idhi:creators ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:doi ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:DigitalHumanitiesActivityEnum ;
            owl:onProperty idhi:digital_humanities_activities ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LicenseEnum ;
            owl:onProperty idhi:license ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Dataset ;
            owl:onProperty idhi:related_datasets ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:prerequisites ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:learning_outcomes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:related_tools ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:doi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:additional_urls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:part_of_training_material ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:date_issued ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:educational_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:media_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:training_material_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:media_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:target_audiences ],
        idhi:Entity ;
    skos:definition "A tutorial, lesson or other didactic resource that explains how to perform an action or states learning outcomes gained by using it. Use TrainingMaterial for resources intended to teach; use Publication for scholarly communication and Tool for software that performs the action itself." ;
    skos:exactMatch schema1:LearningResource ;
    skos:inScheme idhi:idhi .

idhi:address a owl:ObjectProperty ;
    rdfs:label "address" ;
    rdfs:range idhi:LangString ;
    skos:definition "Postal address, multilingual." ;
    skos:inScheme idhi:idhi .

idhi:documentation_url a owl:DatatypeProperty ;
    rdfs:label "documentation_url" ;
    rdfs:range xsd:anyURI ;
    skos:definition "User or developer documentation for the tool or service (manual, wiki, API reference)." ;
    skos:inScheme idhi:idhi .

idhi:location a owl:ObjectProperty ;
    rdfs:label "location" ;
    rdfs:range idhi:LangString ;
    skos:definition "Place name where the organization, facility or event is physically situated (e.g. a city), as free multilingual text." ;
    skos:inScheme idhi:idhi .

idhi:FundingStatusEnum a owl:Class ;
    rdfs:label "FundingStatusEnum" ;
    owl:unionOf ( <https://idhi_placeholder/linkml/FundingStatusEnum#ACTIVE_GRANT_FUNDING> <https://idhi_placeholder/linkml/FundingStatusEnum#INSTITUTIONALLY_SUSTAINED> <https://idhi_placeholder/linkml/FundingStatusEnum#IN_KIND_ONLY> <https://idhi_placeholder/linkml/FundingStatusEnum#VOLUNTEER_RUN> <https://idhi_placeholder/linkml/FundingStatusEnum#UNFUNDED> ) ;
    skos:definition "IDHI-governed values for the current primary way a project is financially or operationally sustained; no established controlled vocabulary covers these project-maintenance states. Historical grants belong in Funding records; choose the value that best describes the project's present circumstances." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values <https://idhi_placeholder/linkml/FundingStatusEnum#ACTIVE_GRANT_FUNDING>,
        <https://idhi_placeholder/linkml/FundingStatusEnum#INSTITUTIONALLY_SUSTAINED>,
        <https://idhi_placeholder/linkml/FundingStatusEnum#IN_KIND_ONLY>,
        <https://idhi_placeholder/linkml/FundingStatusEnum#UNFUNDED>,
        <https://idhi_placeholder/linkml/FundingStatusEnum#VOLUNTEER_RUN> .

idhi:OrgProjectRoleEnum a owl:Class ;
    rdfs:label "OrgProjectRoleEnum" ;
    owl:unionOf ( <https://idhi_placeholder/linkml/OrgProjectRoleEnum#COORDINATOR> <https://idhi_placeholder/linkml/OrgProjectRoleEnum#PARTNER> schema1:provider <https://idhi_placeholder/linkml/OrgProjectRoleEnum#FUNDER> <https://idhi_placeholder/linkml/OrgProjectRoleEnum#HOST> ) ;
    skos:definition "An organization's role in a project (one instance per role)." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values schema1:provider,
        <https://idhi_placeholder/linkml/OrgProjectRoleEnum#COORDINATOR>,
        <https://idhi_placeholder/linkml/OrgProjectRoleEnum#FUNDER>,
        <https://idhi_placeholder/linkml/OrgProjectRoleEnum#HOST>,
        <https://idhi_placeholder/linkml/OrgProjectRoleEnum#PARTNER> .

idhi:ResourceContributionRoleEnum a owl:Class ;
    rdfs:label "ResourceContributionRoleEnum" ;
    owl:unionOf ( dcterms:creator <https://credit.niso.org/contributor-roles/software/> schema1:maintainer <https://credit.niso.org/contributor-roles/data-curation/> dcterms:contributor ) ;
    skos:definition "Roles for named contributions to tools and datasets. Use the most specific responsibility and record separate contributions when one agent holds multiple materially different roles." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values dcterms:contributor,
        dcterms:creator,
        schema1:maintainer,
        <https://credit.niso.org/contributor-roles/data-curation/>,
        <https://credit.niso.org/contributor-roles/software/> .

idhi:EventAgentRoleEnum a owl:Class ;
    rdfs:label "EventAgentRoleEnum" ;
    owl:unionOf ( schema1:organizer <https://idhi_placeholder/linkml/EventAgentRoleEnum#HOST> <https://idhi_placeholder/linkml/EventAgentRoleEnum#SPEAKER> <https://idhi_placeholder/linkml/EventAgentRoleEnum#PANELIST> schema1:attendee schema1:sponsor ) ;
    skos:definition "IDHI-governed roles for people and organizations involved in events. Choose the most specific role and use separate EventAgentRole instances for multiple capacities." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values schema1:attendee,
        schema1:organizer,
        schema1:sponsor,
        <https://idhi_placeholder/linkml/EventAgentRoleEnum#HOST>,
        <https://idhi_placeholder/linkml/EventAgentRoleEnum#PANELIST>,
        <https://idhi_placeholder/linkml/EventAgentRoleEnum#SPEAKER> .

idhi:EventTypeEnum a owl:Class ;
    rdfs:label "EventTypeEnum" ;
    owl:unionOf ( bibo:Conference <https://idhi_placeholder/linkml/EventTypeEnum#WORKSHOP> <https://idhi_placeholder/linkml/EventTypeEnum#SEMINAR> <https://idhi_placeholder/linkml/EventTypeEnum#LECTURE> <https://idhi_placeholder/linkml/EventTypeEnum#HACKATHON> <https://idhi_placeholder/linkml/EventTypeEnum#EXHIBITION> ) ;
    skos:definition "Kinds of scholarly events." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values bibo:Conference,
        <https://idhi_placeholder/linkml/EventTypeEnum#EXHIBITION>,
        <https://idhi_placeholder/linkml/EventTypeEnum#HACKATHON>,
        <https://idhi_placeholder/linkml/EventTypeEnum#LECTURE>,
        <https://idhi_placeholder/linkml/EventTypeEnum#SEMINAR>,
        <https://idhi_placeholder/linkml/EventTypeEnum#WORKSHOP> .

idhi:PersonOrgRoleEnum a owl:Class ;
    rdfs:label "PersonOrgRoleEnum" ;
    owl:unionOf ( <https://idhi_placeholder/linkml/PersonOrgRoleEnum#PROFESSOR> <https://idhi_placeholder/linkml/PersonOrgRoleEnum#ASSOCIATE> <https://idhi_placeholder/linkml/PersonOrgRoleEnum#MEMBER> <https://idhi_placeholder/linkml/PersonOrgRoleEnum#MANAGER> <https://idhi_placeholder/linkml/PersonOrgRoleEnum#AFFILIATE> <https://idhi_placeholder/linkml/PersonOrgRoleEnum#EMPLOYEE> ) ;
    skos:definition "A person's position within an organization (job/status)." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values <https://idhi_placeholder/linkml/PersonOrgRoleEnum#AFFILIATE>,
        <https://idhi_placeholder/linkml/PersonOrgRoleEnum#ASSOCIATE>,
        <https://idhi_placeholder/linkml/PersonOrgRoleEnum#EMPLOYEE>,
        <https://idhi_placeholder/linkml/PersonOrgRoleEnum#MANAGER>,
        <https://idhi_placeholder/linkml/PersonOrgRoleEnum#MEMBER>,
        <https://idhi_placeholder/linkml/PersonOrgRoleEnum#PROFESSOR> .

idhi:Relationship a owl:Class ;
    rdfs:label "Relationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:end_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:start_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:end_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty idhi:end_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty idhi:start_date ],
        [ owl:unionOf ( idhi:Affiliation idhi:Authorship idhi:EventAgentRole idhi:FacilityAffiliation idhi:OrganizationHierarchy idhi:OrganizationProjectRole idhi:ProjectParticipation idhi:ResourceContribution ) ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:start_date ] ;
    skos:definition "Abstract base for reified relationships that carry their own role or validity metadata. A Relationship is used instead of a direct edge whenever the connection between two entities needs its own metadata: a role and/or a validity interval. Never instantiated directly." ;
    skos:exactMatch schema1:Role ;
    skos:inScheme idhi:idhi .

idhi:Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom idhi:ToolServiceTypeEnum ;
            owl:onProperty idhi:service_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:documentation_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "idhi:Service" ] ) ] ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:documentation_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:documentation_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:digital_humanities_activities ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:service_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:additional_urls ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:DigitalHumanitiesActivityEnum ;
            owl:onProperty idhi:digital_humanities_activities ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:additional_urls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:provider ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:service_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Organization ;
            owl:onProperty idhi:provider ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:provider ],
        idhi:Entity ;
    skos:definition "A reusable, human- or organization-mediated service offered by a facility or organization (e.g., digitization on demand, OCR consulting, data curation support). Use Service when the offering requires the provider to act; use Tool for self-service software." ;
    skos:exactMatch schema1:Service ;
    skos:inScheme idhi:idhi .

idhi:TrainingMaterialTypeEnum a owl:Class ;
    rdfs:label "TrainingMaterialTypeEnum" ;
    owl:unionOf ( schema1:HowTo <https://idhi_placeholder/linkml/TrainingMaterialTypeEnum#LESSON> <https://idhi_placeholder/linkml/TrainingMaterialTypeEnum#COURSE_MATERIAL> <https://idhi_placeholder/linkml/TrainingMaterialTypeEnum#WORKSHOP_MATERIAL> <https://idhi_placeholder/linkml/TrainingMaterialTypeEnum#SELF_PACED_EXERCISE> <https://idhi_placeholder/linkml/TrainingMaterialTypeEnum#OTHER_DIDACTIC_RESOURCE> ) ;
    skos:definition "Didactic forms of training material. Choose the form that describes the learner's intended mode of engagement rather than the resource's technical format." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values schema1:HowTo,
        <https://idhi_placeholder/linkml/TrainingMaterialTypeEnum#COURSE_MATERIAL>,
        <https://idhi_placeholder/linkml/TrainingMaterialTypeEnum#LESSON>,
        <https://idhi_placeholder/linkml/TrainingMaterialTypeEnum#OTHER_DIDACTIC_RESOURCE>,
        <https://idhi_placeholder/linkml/TrainingMaterialTypeEnum#SELF_PACED_EXERCISE>,
        <https://idhi_placeholder/linkml/TrainingMaterialTypeEnum#WORKSHOP_MATERIAL> .

idhi:digital_humanities_activities a owl:ObjectProperty ;
    rdfs:label "digital_humanities_activities" ;
    rdfs:range idhi:DigitalHumanitiesActivityEnum ;
    skos:definition "Digital-humanities research activities practiced in this project, tool or service, or taught by this training material. Prefer the most specific applicable activity; multiple values are expected. This is the primary DH-facet for discovery." ;
    skos:inScheme idhi:idhi .

idhi:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:subClassOf [ owl:unionOf ( idhi:Organization idhi:Person ) ],
        idhi:Entity ;
    skos:definition "A person or an organization." ;
    skos:exactMatch foaf:Agent ;
    skos:inScheme idhi:idhi .

idhi:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:same_as ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:same_as ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:tags ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:tags ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:homepage ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:homepage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:image ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:homepage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:image ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:description ],
        [ owl:unionOf ( idhi:Agent idhi:Dataset idhi:Event idhi:Facility idhi:Project idhi:Publication idhi:Service idhi:Tool idhi:TrainingMaterial ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:base64Binary ;
            owl:onProperty idhi:image ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^idhi:[a-z_]+:[0-9a-z]{4,12}$" ] ) ] ) ] ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:type ] ;
    skos:definition "Root class for any identifiable IDHI entity. Provides the IDHI URN id, multilingual description, optional embedded image, homepage, same_as links and tags. Never instantiated directly; every concrete entity inherits from it and constrains the id's class token via slot_usage." ;
    skos:exactMatch schema1:Thing ;
    skos:inScheme idhi:idhi .

idhi:OrganizationTypeEnum a owl:Class ;
    rdfs:label "OrganizationTypeEnum" ;
    owl:unionOf ( schema1:CollegeOrUniversity <https://idhi_placeholder/linkml/OrganizationTypeEnum#GLAM_INSTITUTION> schema1:ResearchOrganization schema1:FundingScheme schema1:Corporation schema1:NGO <https://idhi_placeholder/linkml/OrganizationTypeEnum#INFORMAL_GROUP> ) ;
    skos:definition "Kinds of organization. Canonical discriminator for Organization; pick the value matching the organization's PRIMARY nature." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values schema1:CollegeOrUniversity,
        schema1:Corporation,
        schema1:FundingScheme,
        schema1:NGO,
        schema1:ResearchOrganization,
        <https://idhi_placeholder/linkml/OrganizationTypeEnum#GLAM_INSTITUTION>,
        <https://idhi_placeholder/linkml/OrganizationTypeEnum#INFORMAL_GROUP> .

idhi:date_issued a owl:DatatypeProperty ;
    rdfs:label "date_issued" ;
    rdfs:range xsd:date ;
    skos:definition "Formal publication date (or year-01-01 if only the year is known)." ;
    skos:inScheme idhi:idhi .

idhi:license a owl:ObjectProperty ;
    rdfs:label "license" ;
    rdfs:range idhi:LicenseEnum ;
    skos:definition "The license under which the tool, dataset or training material is released. Required for anything advertised as reusable; omit only if genuinely unknown." ;
    skos:inScheme idhi:idhi .

idhi:organization a owl:ObjectProperty ;
    rdfs:label "organization" ;
    rdfs:range idhi:Organization ;
    skos:definition "The organization referenced by a person affiliation, facility affiliation or project role (by IDHI URN). The Person, Facility or Project containing the relationship supplies its other endpoint." ;
    skos:inScheme idhi:idhi .

idhi:publisher a owl:ObjectProperty ;
    rdfs:label "publisher" ;
    rdfs:range idhi:Organization ;
    skos:definition "The organization formally publishing the dataset, publication or training material (by IDHI URN); use creators for responsibility for making a training material." ;
    skos:inScheme idhi:idhi .

idhi:DatasetTypeEnum a owl:Class ;
    rdfs:label "DatasetTypeEnum" ;
    owl:unionOf ( <https://idhi_placeholder/linkml/DatasetTypeEnum#DIGITAL_EDITION> <https://idhi_placeholder/linkml/DatasetTypeEnum#CORPUS> <https://idhi_placeholder/linkml/DatasetTypeEnum#DATABASE> <https://idhi_placeholder/linkml/DatasetTypeEnum#GAZETTEER> <https://idhi_placeholder/linkml/DatasetTypeEnum#IMAGE_COLLECTION> <https://idhi_placeholder/linkml/DatasetTypeEnum#ANNOTATION_SET> <https://idhi_placeholder/linkml/DatasetTypeEnum#METADATA_CATALOG> <https://idhi_placeholder/linkml/DatasetTypeEnum#OTHER_RESEARCH_DATA> ) ;
    skos:definition "IDHI-governed discovery categories for datasets and dataset-like intellectual objects. Choose the primary form and use tags for secondary characteristics." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values <https://idhi_placeholder/linkml/DatasetTypeEnum#ANNOTATION_SET>,
        <https://idhi_placeholder/linkml/DatasetTypeEnum#CORPUS>,
        <https://idhi_placeholder/linkml/DatasetTypeEnum#DATABASE>,
        <https://idhi_placeholder/linkml/DatasetTypeEnum#DIGITAL_EDITION>,
        <https://idhi_placeholder/linkml/DatasetTypeEnum#GAZETTEER>,
        <https://idhi_placeholder/linkml/DatasetTypeEnum#IMAGE_COLLECTION>,
        <https://idhi_placeholder/linkml/DatasetTypeEnum#METADATA_CATALOG>,
        <https://idhi_placeholder/linkml/DatasetTypeEnum#OTHER_RESEARCH_DATA> .

idhi:LicenseEnum a owl:Class ;
    rdfs:label "LicenseEnum" ;
    owl:unionOf ( <https://creativecommons.org/licenses/by/4.0/> <https://creativecommons.org/licenses/by-sa/4.0/> <https://creativecommons.org/publicdomain/zero/1.0/> spdx:MIT spdx:Apache-2.0 spdx:GPL-3.0-or-later ) ;
    skos:definition "Common licenses for tools, datasets and training materials. Extend as needed with canonical meanings." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values <https://creativecommons.org/licenses/by-sa/4.0/>,
        <https://creativecommons.org/licenses/by/4.0/>,
        <https://creativecommons.org/publicdomain/zero/1.0/>,
        spdx:Apache-2.0,
        spdx:GPL-3.0-or-later,
        spdx:MIT .

idhi:Tool a owl:Class ;
    rdfs:label "Tool" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:documentation_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LicenseEnum ;
            owl:onProperty idhi:license ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:license ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:ResourceContribution ;
            owl:onProperty idhi:resource_contributions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:programming_language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:tool_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:doi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:code_repository ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:documentation_url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:additional_urls ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:programming_language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:doi ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:DigitalHumanitiesActivityEnum ;
            owl:onProperty idhi:digital_humanities_activities ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:doi ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:ToolServiceTypeEnum ;
            owl:onProperty idhi:tool_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:additional_urls ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:code_repository ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:programming_language ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:code_repository ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:documentation_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:license ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:tool_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "idhi:Tool" ] ) ] ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:digital_humanities_activities ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:resource_contributions ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:contact_email ],
        idhi:Entity ;
    skos:definition "A reusable software tool, typically produced by a project. Use Tool for software that others can install, run or call; for a human-mediated offering use Service instead." ;
    skos:exactMatch schema1:SoftwareApplication ;
    skos:inScheme idhi:idhi .

idhi:ProjectRoleEnum a owl:Class ;
    rdfs:label "ProjectRoleEnum" ;
    owl:unionOf ( <https://idhi_placeholder/linkml/ProjectRoleEnum#PRINCIPAL_INVESTIGATOR> <https://idhi_placeholder/linkml/ProjectRoleEnum#CO_PI> <https://credit.niso.org/contributor-roles/investigation/> <https://credit.niso.org/contributor-roles/methodology/> <https://credit.niso.org/contributor-roles/software/> <https://credit.niso.org/contributor-roles/software/> <https://idhi_placeholder/linkml/ProjectRoleEnum#STUDENT> <https://credit.niso.org/contributor-roles/supervision/> <https://idhi_placeholder/linkml/ProjectRoleEnum#CONSULTANT> <https://idhi_placeholder/linkml/ProjectRoleEnum#CONTRIBUTOR> ) ;
    skos:definition "A person's role in a project. Where a CRediT (Contributor Roles Taxonomy) concept approximates the role, `meaning:` records it." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values <https://credit.niso.org/contributor-roles/investigation/>,
        <https://credit.niso.org/contributor-roles/methodology/>,
        <https://credit.niso.org/contributor-roles/software/>,
        <https://credit.niso.org/contributor-roles/supervision/>,
        <https://idhi_placeholder/linkml/ProjectRoleEnum#CONSULTANT>,
        <https://idhi_placeholder/linkml/ProjectRoleEnum#CONTRIBUTOR>,
        <https://idhi_placeholder/linkml/ProjectRoleEnum#CO_PI>,
        <https://idhi_placeholder/linkml/ProjectRoleEnum#PRINCIPAL_INVESTIGATOR>,
        <https://idhi_placeholder/linkml/ProjectRoleEnum#STUDENT> .

idhi:Dataset a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:license ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Dataset ;
            owl:onProperty idhi:derived_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:distribution_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "idhi:Dataset" ] ) ] ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Publication ;
            owl:onProperty idhi:related_publications ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:doi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:doi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:byte_size ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:distribution_url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:distribution_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:in_languages ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:byte_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:ResourceContribution ;
            owl:onProperty idhi:resource_contributions ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Dataset ;
            owl:onProperty idhi:datasets ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:Organization ;
            owl:onProperty idhi:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:doi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:themes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:extent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:media_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:date_issued ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:derived_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:dataset_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:related_publications ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty idhi:date_issued ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:datasets ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:DatasetTypeEnum ;
            owl:onProperty idhi:dataset_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:dataset_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LicenseEnum ;
            owl:onProperty idhi:license ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:themes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty idhi:byte_size ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:media_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*$" ] ) ] ) ] ;
            owl:onProperty idhi:in_languages ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:license ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:extent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:resource_contributions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:date_issued ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:id ],
        idhi:Entity ;
    skos:definition "A dataset or dataset-like intellectual object produced or curated by a project: digital editions, corpora, databases, gazetteers, image collections, annotation sets and metadata catalogs. Use Dataset for research data, digital scholarly editions and catalogs that describe other resources; a catalog can link the datasets it aggregates through datasets." ;
    skos:exactMatch dcat:Dataset ;
    skos:inScheme idhi:idhi .

idhi:ToolServiceTypeEnum a owl:Class ;
    rdfs:label "ToolServiceTypeEnum" ;
    owl:unionOf ( schema1:WebApplication <https://idhi_placeholder/linkml/ToolServiceTypeEnum#DESKTOP_APPLICATION> <https://idhi_placeholder/linkml/ToolServiceTypeEnum#LIBRARY> <https://idhi_placeholder/linkml/ToolServiceTypeEnum#COMMAND_LINE_TOOL> <https://idhi_placeholder/linkml/ToolServiceTypeEnum#DATABASE> <https://idhi_placeholder/linkml/ToolServiceTypeEnum#API_SERVICE> <https://idhi_placeholder/linkml/ToolServiceTypeEnum#DIGITIZATION_SERVICE> <https://idhi_placeholder/linkml/ToolServiceTypeEnum#CONSULTING_SERVICE> ) ;
    skos:definition "Delivery forms for tools and kinds of services. Tool records use the software values; Service records use the service values." ;
    skos:inScheme idhi:idhi ;
    linkml:permissible_values schema1:WebApplication,
        <https://idhi_placeholder/linkml/ToolServiceTypeEnum#API_SERVICE>,
        <https://idhi_placeholder/linkml/ToolServiceTypeEnum#COMMAND_LINE_TOOL>,
        <https://idhi_placeholder/linkml/ToolServiceTypeEnum#CONSULTING_SERVICE>,
        <https://idhi_placeholder/linkml/ToolServiceTypeEnum#DATABASE>,
        <https://idhi_placeholder/linkml/ToolServiceTypeEnum#DESKTOP_APPLICATION>,
        <https://idhi_placeholder/linkml/ToolServiceTypeEnum#DIGITIZATION_SERVICE>,
        <https://idhi_placeholder/linkml/ToolServiceTypeEnum#LIBRARY> .

idhi:doi a owl:DatatypeProperty ;
    rdfs:label "doi" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The publication, dataset, tool or training material's DOI persistent identifier. Record it whenever one exists; it is the preferred deduplication key and is supplementary to the IDHI URN." ;
    skos:inScheme idhi:idhi .

idhi:end_date a owl:DatatypeProperty ;
    rdfs:label "end_date" ;
    rdfs:range xsd:date ;
    skos:definition "End of the event, project runtime or relationship. Omit for ongoing relationships and open-ended projects." ;
    skos:inScheme idhi:idhi .

idhi:start_date a owl:DatatypeProperty ;
    rdfs:label "start_date" ;
    rdfs:range xsd:date ;
    skos:definition "Start of the event, of the project's runtime, or of a relationship's validity, such as when participation, affiliation, maintenance responsibility or formal containment began." ;
    skos:inScheme idhi:idhi .

idhi:additional_urls a owl:DatatypeProperty ;
    rdfs:label "additional_urls" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Further relevant web pages beyond the homepage (blog, social-media profile, registry entry, press coverage...). For records describing the same entity in other systems use same_as instead." ;
    skos:inScheme idhi:idhi .

idhi:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:organization_hierarchy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:additional_urls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:ror ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:organization_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:additional_urls ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty idhi:ror ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:marketplace_sync ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:ror ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:address ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:marketplace_sync ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "idhi:Organization" ] ) ] ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty idhi:marketplace_sync ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:location ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:address ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:OrganizationTypeEnum ;
            owl:onProperty idhi:organization_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:contact_email ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:OrganizationHierarchy ;
            owl:onProperty idhi:organization_hierarchy ],
        [ a owl:Restriction ;
            owl:allValuesFrom idhi:LangString ;
            owl:onProperty idhi:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:organization_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty idhi:location ],
        idhi:Agent ;
    skos:definition "An organization of any kind. Its kind (academic institution, GLAM, research center, funder, company, non-profit or informal group) is given by organization_type. All organizations use the idhi:organization:<shortid> URN form." ;
    skos:exactMatch foaf:Organization ;
    skos:inScheme idhi:idhi .

idhi:name a owl:ObjectProperty ;
    rdfs:label "name" ;
    rdfs:range idhi:LangString ;
    skos:definition "The multilingual name or title used to identify the entity. Use one LangString per available language and do not repeat a language. Prefer the official localized name for organizations; for projects, tools and services, use localized names supplied by the team rather than translating branded names without authority." ;
    skos:inScheme idhi:idhi .

idhi:contact_email a owl:DatatypeProperty ;
    rdfs:label "contact_email" ;
    skos:definition "A published contact address for the entity (office, team or service-desk mailbox). For a person's own addresses use 'emails'." ;
    skos:inScheme idhi:idhi .

idhi:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^idhi:[a-z_]+:[0-9a-z]{4,12}$" ] ) ] ) ] ;
    skos:definition """The entity's primary identifier: an IDHI URN of the form
  idhi:<class name>:<random short alphanumeric id>
e.g. idhi:person:x7k2m9 or idhi:project:a83bq1. Minted by IDHI at record creation and never reused or changed. The class token is the lowercase snake_case class name; each concrete class enforces its own token via slot_usage. External identifiers (ORCID, ROR, DOI...) are supplementary and go in their dedicated slots — never here.""" ;
    skos:inScheme idhi:idhi .

idhi:type a owl:DatatypeProperty ;
    rdfs:label "type" ;
    rdfs:range xsd:string ;
    skos:definition "Discriminator identifying the record's class; used for polymorphic serialization and deserialization." ;
    skos:inScheme idhi:idhi .

idhi:LangString a owl:Class ;
    rdfs:label "LangString" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty idhi:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty idhi:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*$" ] ) ] ) ] ;
            owl:onProperty idhi:language ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty idhi:language ] ;
    skos:definition "A single language-tagged text value. Instances are combined in a multivalued slot to give variants of one field in any language identified by a BCP-47 tag. Use one LangString per language; do not repeat a language within the same field." ;
    skos:exactMatch rdf:langString ;
    skos:inScheme idhi:idhi .

